# Salelular — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Whapi.cloud ──────────────────────────────────────────────────────────────
# Partner API token (from Whapi dashboard, under Partner section)
WHAPI_PARTNER_TOKEN=

# Project ID (from Whapi dashboard)
WHAPI_PROJECT_ID=

# Per-operator channel (used by scripts/check_session.py --create-test-operator
# to seed a test operator). In production these come from the onboarding flow
# and are stored in the operators DB table.
WHAPI_CHANNEL_ID=
WHAPI_CHANNEL_TOKEN=

# Operator profile (used only by --create-test-operator)
OPERATOR_SHOP_NAME=Test Shop
OPERATOR_OWNER_NAME=Test Owner
OWNER_PERSONAL_PHONE=

# ── LLM provider ─────────────────────────────────────────────────────────────
# Choose one provider. LLM_API_KEY accepts the corresponding key.
# Switch providers by changing LLM_PROVIDER + LLM_API_KEY + LLM_MODEL.
#
# Anthropic Claude (default):
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_MODEL=claude-sonnet-4-6
#   VISION_MODEL=claude-sonnet-4-6
#   CLASSIFIER_MODEL=claude-haiku-4-5-20251001
#
# Groq (Llama models — temporary alt while Anthropic credits unavailable):
#   LLM_PROVIDER=groq
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
#   VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   CLASSIFIER_MODEL=llama-3.3-70b-versatile

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Vision provider can differ from LLM_PROVIDER. Defaults to LLM_PROVIDER.
VISION_PROVIDER=anthropic
VISION_API_KEY=
VISION_MODEL=claude-sonnet-4-6

CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Legacy alias — read as fallback for LLM_API_KEY when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Base64-encode your service account JSON:
# python -c "import base64; print(base64.b64encode(open('creds.json','rb').read()).decode())"
GOOGLE_CREDENTIALS_JSON=

# The spreadsheet ID (from the sheet URL).
GOOGLE_SHEETS_ID=

# Tab name within the spreadsheet (default Sheet1).
GOOGLE_SHEET_NAME=Sheet1

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_URL=sqlite:///salelular.db

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with:
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# ── Tuning (optional — defaults shown) ───────────────────────────────────────
BUFFER_DEBOUNCE_MS=3000
BUFFER_RATE_LIMIT_S=8
SESSION_EXPIRY_DAYS=7
MAX_HISTORY_TURNS=10
SEARCH_THRESHOLD=55
MAX_MESSAGES_PER_USER_DAY=100
INVENTORY_REFRESH_INTERVAL_S=300
WHAPI_HEALTH_CHECK_INTERVAL_S=1800
PORT=8000

# Public HTTPS URL where your server is reachable (used to configure webhooks).
# Production: your real domain. Development: ngrok/cloudflared tunnel URL.
SERVER_URL=https://your-domain.com
