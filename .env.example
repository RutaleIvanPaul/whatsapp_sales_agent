# Salelular — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Whapi.cloud ──────────────────────────────────────────────────────────────
# Partner API token (from Whapi dashboard, under Partner section)
WHAPI_PARTNER_TOKEN=

# Project ID (from Whapi dashboard)
WHAPI_PROJECT_ID=

# Per-operator channel (used by scripts/check_session.py --create-test-operator
# to seed a test operator). In production these come from the onboarding flow
# and are stored in the operators DB table.
WHAPI_CHANNEL_ID=
WHAPI_CHANNEL_TOKEN=

# Operator profile (used only by --create-test-operator)
OPERATOR_SHOP_NAME=Test Shop
OPERATOR_OWNER_NAME=Test Owner
OWNER_PERSONAL_PHONE=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Models (these defaults work — change if needed)
LLM_MODEL=gpt-4o
VISION_MODEL=gpt-4o
CLASSIFIER_MODEL=gpt-4o-mini

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Base64-encode your service account JSON:
# python -c "import base64; print(base64.b64encode(open('creds.json','rb').read()).decode())"
GOOGLE_CREDENTIALS_JSON=

# The spreadsheet ID (from the sheet URL).
GOOGLE_SHEETS_ID=

# Tab name within the spreadsheet (default Sheet1).
GOOGLE_SHEET_NAME=Sheet1

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_URL=sqlite:///salelular.db

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with:
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# ── Tuning (optional — defaults shown) ───────────────────────────────────────
BUFFER_DEBOUNCE_MS=3000
BUFFER_RATE_LIMIT_S=8
SESSION_EXPIRY_DAYS=7
MAX_HISTORY_TURNS=10
SEARCH_THRESHOLD=70
MAX_MESSAGES_PER_USER_DAY=100
INVENTORY_REFRESH_INTERVAL_S=300
WHAPI_HEALTH_CHECK_INTERVAL_S=1800
PORT=8000
